# Google Gemini API key, used only for open-ended constraint/correction interpretation.
# Numeric values (budget, dates) are ALWAYS parsed deterministically in extraction/normalize.py
# and never trusted from the LLM alone. If this is unset, the system falls back to
# rule-based extraction only (weaker on open-ended phrasing, but fully functional).
GEMINI_API_KEY=

# Host/port for the FastAPI dev server.
HOST=0.0.0.0
PORT=8000
